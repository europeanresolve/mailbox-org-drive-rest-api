		"mongodb": "7.9.1",
		"p-limit": "7.3.3",
		"p-retry": "9.0.0",
		"pino": "10.4.0",
		"typebox": "1.4.7",
		"webdav": "5.11.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
